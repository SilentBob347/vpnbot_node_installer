{
  "schema_version": 2,
  "policy_id": "vpnbot-node-disk-hygiene-v2",
  "apt": {
    "clean_archives": true,
    "lock_timeout_seconds": 30
  },
  "journal": {
    "system_max_use": "256M",
    "system_keep_free": "2G",
    "system_max_file_size": "32M",
    "runtime_max_use": "64M",
    "runtime_keep_free": "512M",
    "runtime_max_file_size": "16M",
    "max_retention_sec": "7day",
    "max_file_sec": "12h",
    "vacuum_size": "256M",
    "vacuum_time": "7day"
  },
  "protocol_logrotate": {
    "config_dir": "/etc/vpnbot/logrotate.d"
  },
  "timer": {
    "on_boot_sec": "5min",
    "on_unit_active_sec": "1h",
    "randomized_delay_sec": "10min"
  }
}
